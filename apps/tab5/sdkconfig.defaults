# Bedientafel (Tab5) — Vorgaben für ESP-IDF 6.0.2.
# Übernommen vom Tab5 von camperSense (satellite-display/tab5/sdkconfig.defaults);
# was die Bedientafel nicht braucht (Bluetooth, Kamera, Sprache), fehlt.
# ⚠️ sdkconfig.defaults wirkt nur auf eine FRISCHE sdkconfig: nach einer Änderung
# `rm -f sdkconfig`.

# ---- Chip ------------------------------------------------------------------
# ⚠️⚠️ Der Tab5 trägt einen ESP32-P4 der Revision v1.x. Ohne diese zwei Zeilen
# startet das Image nicht (Vorgabe ab IDF 5.5.3: mindestens v3.1).
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# ---- Flash und Partitionen ---------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- PSRAM, Cache, Takt ------------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# ⚠️⚠️ Fast alles ins PSRAM, 96 KB intern für DMA: sonst fehlen ESP-Hosted beim
# Start des Funkmoduls die DMA-Deskriptoren (camperSense, Falle 36).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- Konsole über USB-C ------------------------------------------------------
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ---- Display und LVGL --------------------------------------------------------
CONFIG_LVGL_PORT_ENABLE_PPA=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_USE_SNAPSHOT=y
# ⚠️⚠️ LVGL-Speicher aus dem System-Heap; der eingebaute Pool (64 KB) läuft beim
# Bildlauf leer und endet als Zugriffsfehler nahe Adresse 0.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_ASSERT_MALLOC=y
CONFIG_LV_USE_ASSERT_NULL=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_USE_PPA=y
CONFIG_LV_USE_PPA_IMG=y
CONFIG_LV_DRAW_BUF_ALIGN=128
CONFIG_LV_DEF_REFR_PERIOD=16
# Linien und Bögen für Stellrad, Verlauf und Anlagenschema
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_DRAW_SW_COMPLEX=y

# ---- ESP-Hosted 3.x: Host auf dem P4, Coprozessor ESP32-C6 über SDIO ----------
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST=y
CONFIG_ESP_HOSTED_HOST_TYPE_MCU=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=40000
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=15
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y
CONFIG_ESP_HOSTED_HOST_FEAT_BT=n
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
# ⚠️⚠️ Kein Start vor app_main: der C6 bekommt erst über die IO-Erweiterung
# (BSP_FEATURE_WIFI) Strom.
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n
CONFIG_ESP_HOSTED_HOST_TRANSPORT_RESTART_ON_FAILURE=n

# ---- TLS (Anthropic-API) -----------------------------------------------------
# ⚠️ Die ECDSA-Einheit des P4 arbeitet erst ab Revision v3; gleich in Software.
CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# ⚠️⚠️ api.anthropic.com liefert „GTS Root R4“ als Zwischenzertifikat, gegengezeichnet von der
# alten „GlobalSign Root CA“, die nicht im Bündel steht. Ohne diese Einstellung sucht der Prüfer
# nur nach dem Aussteller des obersten Zertifikats und scheitert („No matching trusted root
# certificate found“, -0x3000; am Gerät, 10.11.2026), obwohl GTS Root R4 selbst im Bündel ist.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# ---- HTTP --------------------------------------------------------------------
# Die Geräte im Heimnetz sprechen HTTP ohne TLS (wie NSAllowsLocalNetworking der App).
CONFIG_ESP_HTTP_CLIENT_ENABLE_BASIC_AUTH=y

# ---- WLAN-Durchsatz ----------------------------------------------------------
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_MAX_SOCKETS=16

# ---- Zeit --------------------------------------------------------------------
CONFIG_LWIP_SNTP_MAX_SERVERS=2
